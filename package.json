{
  "name": "memoriser",
  "productName": "Memoriser",
  "private": true,
  "version": "0.0.0",
  "repository": "Vikramadtya/Mneme",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'electron/**/*.ts'",
    "test": "vitest run",
    "build:mac": "npm run build && electron-builder --mac",
    "publish:github": "npm run build && electron-builder --mac --publish always",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@fontsource-variable/geist": "^5.2.9",
    "@huggingface/transformers": "^4.2.0",
    "@uiw/codemirror-theme-vscode": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.11",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "glob": "^13.0.6",
    "highlight.js": "^11.11.1",
    "html-react-parser": "^6.1.3",
    "immer": "^11.1.9",
    "katex": "^0.17.0",
    "lru-cache": "^11.5.1",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.10",
    "nanoid": "^5.1.16",
    "react-diff-viewer-continued": "^4.2.2",
    "react-loading-skeleton": "^3.5.0",
    "react-virtuoso": "^4.18.10",
    "scheduler": "^0.27.0",
    "shadcn": "^4.12.0",
    "sharp": "^0.35.3",
    "shiki": "^4.3.0",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tinykeys": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "use-context-selector": "^2.0.0",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.5.2",
    "cmdk": "^1.1.1",
    "concurrently": "^8.2.2",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "lucide-react": "^1.21.0",
    "million": "^3.1.11",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-activity-calendar": "^3.2.0",
    "react-dom": "^19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "react-medium-image-zoom": "^5.4.8",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.1.0",
    "vite-plugin-checker": "^0.14.4",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^1.5.0",
    "wait-on": "^7.2.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.memoriser.app",
    "productName": "Memoriser",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "vault-template",
        "to": "vault-template",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "buildResources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint"
    ]
  }
}
