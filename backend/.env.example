# Required
MONGO_URI=mongodb://memoriser:change-me@localhost:27017/memoriser?authSource=admin
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Same OAuth client id the frontend uses (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Optional
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
PORT=8080
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
